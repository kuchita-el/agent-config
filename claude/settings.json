{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Bash(ls *)",
      "Bash(jq *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh pr review * --comment*)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh repo view *)",
      "Bash(gh api *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git worktree list*)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(mkdir -p *)",
      "Bash(gzip *)",
      "Bash(wc *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(rg *)",
      "EnterWorktree",
      "ExitWorktree",
      "Skill(pr-review-toolkit:review-pr)",
      "mcp__ide__getDiagnostics",
      "LSP"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(* > .env*)",
      "Bash(* > *.env*)",
      "Bash(* >> .env*)",
      "Bash(* >> *.env*)"
    ],
    "ask": [
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force*)",
      "Bash(git checkout *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(docker *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-dotenv.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' '権限確認を待っています' --urgency=normal 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' '入力待ちです' --urgency=low 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/save-last-reply.sh"
          },
          {
            "type": "prompt",
            "model": "claude-sonnet-5-5",
            "timeout": 60,
            "prompt": "あなたは、AIアシスタントの応答のうち、利用者に判断を求めている箇所が、利用者に通じるかを判定する。読み手は、この作業を依頼している利用者本人。利用者は作業の経緯や作業中の文書の中身を覚えていないものとする。\n\n入力はフックの入力 JSON で、last_assistant_message が判定する応答、stop_hook_active はこの判定で一度差し戻した後に続いた応答かどうかを表す。stop_hook_active が true なら、内容を見ずに {\"ok\": true} を返す。\n\n手順:\n1. 応答の中に、利用者に判断・選択・承認を求めている箇所があるかを見る。問いの文、選択肢の列挙、「〜するか」「どれにするか」「進めてよいか」の類。無ければ {\"ok\": true} を返して終える。報告の中の分からない語は、判断を求める箇所に関わらない限り問わない。\n2. 判断を求める箇所について、利用者がその応答だけを読んで次の3点に答えられるかを見る。\n   - 何を決めればよいのか\n   - 選択肢どうしで、結果として何が違うのか\n   - 判断の要になる語の意味。要の語とは、問いの主語・目的語、選択肢の名前や中身、推奨の理由に出てくる語を指す\n3. 要の語について、特に次を疑う。\n   - 作業の中で付いた記号・番号（判断・決定・受入条件・仮説・論点・案の番号や記号、節番号、Issue・PR 番号、行番号）\n   - 見た目はふつうの言葉だが、この作業の中で特別な意味で使われている語（作業の中で付けた呼び名、文書の中の項目名、指す先が定まらない「この〜」「例の〜」の類）。ふつうの言葉の意味のままでは、問いの文が具体的に何を指すか分からない語がこれに当たる\n   - 一般の開発者に通じない専門語・規格名\n\n利用者が知っているとみなしてよいもの: 一般の開発者に通じる製品名・サービス名・規格名・版番号・ホスト名とポート・コンテナのイメージ名とタグ、応答の中で意味を添えた語、括弧の中に脇置きした記号、コードブロック・インラインコードの中、リンク。\n\n出力は JSON だけにする。通じるなら {\"ok\": true}。通じないなら {\"ok\": false, \"reason\": \"<理由>\"}。理由には、答えられない点（何を決めるか／選択肢の違い／要の語）と、意味の取れない要の語を、理解を最も妨げる順に挙げたうえで「判断を求める箇所だけを、要の語を中身の言葉に置き換え、選択肢ごとに結果として何が変わるかを具体例で添えて言い直し、追記として出す。全文は繰り返さない」と書く。\n\n入力: $ARGUMENTS"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/log-confusion.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "dev-workflow@claude-shared-skills": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-shared-skills": {
      "source": {
        "source": "github",
        "repo": "kuchita-el/claude-shared-skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "codeload.github.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "git commit *",
      "git merge *",
      "git rebase *",
      "git cherry-pick *",
      "git revert *",
      "git tag *",
      "git push",
      "git push *",
      "git pull",
      "git pull *",
      "git fetch",
      "git fetch *",
      "git ls-remote *",
      "git clone *",
      "docker *"
    ]
  },
  "theme": "dark",
  "autoMode": {
    "environment": [
      "$defaults"
    ]
  }
}
